local art=Instance.new("ModuleScript");art.Name="FeatureUIArt";art.Source=moduleSource
local ok,err=pcall(function()
	art.Parent=RS
	for _,s in ipairs(staged) do s.target.Source=s.source end
end)
if not ok then
	for _,s in ipairs(staged) do s.target.Source=s.previous end
	art:Destroy();backup:SetAttribute("InstallFailed",tostring(err));error(tostring(err))
end
backup:SetAttribute("Installed",true)
local result={assets=10,backup=backup:GetFullName(),scripts={}}
