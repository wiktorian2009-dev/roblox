 --------------------------------------------------
 -- OPEN / CLOSE
 --------------------------------------------------
+-- UI audit F24 (one menu at a time): opening this full-screen page must not leave another menu open behind it.
+-- * The RNG panel + its blur: open() fires NO bus event (a VillageOpenMenu "CloseAll" would hit this script's own handler below and close the page again).
+--   RNGClient's Studio patch (PENDING) watches this ScreenGui's Enabled and closes its panel itself.
+-- * Everything else is closed here by direct, pcall-guarded calls, the way MiniPlowClient / TravelClient / PlowTutorialClient close the other menus: the HELP menu
+--   (PlowTutorial, DisplayOrder 200, would sit ON TOP of the page), the garage / equip window and the offer card (PlowShopGui 101), the inspect panel of another
+--   player's car (GarageInspectGui 102), the egg screen (VerityEggGui 103) and MINI PLOWS (MiniPlowGui 6; it also closes itself by polling). Left open they would
+--   sit under the page and come back when it closes.
+-- * Offer cards / popups wait on UILayout.openMenu (e.g. PassClient.panelsOpen), which already reports this page via UpgradeTreeGui.Enabled; nothing is hidden from here.
+local plowApi
+local function getPlowApi() -- PlowClientApi (ReplicatedStorage, Rojo source): looked up without waiting, so a missing module can never stall this script
+	if plowApi then return plowApi end
+	local m = ReplicatedStorage:FindFirstChild("PlowClientApi")
+	if m and m:IsA("ModuleScript") then
+		local ok, res = pcall(require, m)
+		if ok and type(res) == "table" then plowApi = res end
+	end
+	return plowApi
+end
+local function hideMenuObject(guiName, objName) -- nil-safe: the other script may not have built its screen yet
+	local g = player.PlayerGui:FindFirstChild(guiName)
+	local o = g and g:FindFirstChild(objName)
+	if o and o:IsA("GuiObject") and o.Visible then o.Visible = false end
+end
+local function closeOtherMenus()
+	hideMenuObject("PlowTutorial", "HelpMenu")
+	local api = getPlowApi() -- every Api.CloseX is a safe no-op until its client script overrides it
+	if api then
+		if api.CloseBuild then pcall(api.CloseBuild) end     -- garage / equip window
+		if api.CloseCard then pcall(api.CloseCard) end       -- offer card
+		if api.CloseInspect then pcall(api.CloseInspect) end -- inspect panel of another player's car
+	end
+	hideMenuObject("VerityEggGui", "EggScreen") -- VerityEggClient releases its Esc / B binding from the Visible change
+	hideMenuObject("MiniPlowGui", "MiniPlowPanel")
+end
+-- A "CloseAll" that another menu script fires on VillageOpenMenu while this page is only just opening is an echo of the open itself
+-- (e.g. TravelClient dropping its panel when RNGClient hides it) and must not close the page again, so it is ignored for OPEN_ECHO_WINDOW seconds.
+-- Later "CloseAll" events still close the page on purpose: PlowShopClient / PlowGarageClient / MiniPlowClient / PlowTutorialClient fire it when THEY open a menu
+-- (garage 101, inspect 102 and MINI PLOWS 6 would otherwise sit under this page, 150) and they rely on this script closing on any name but "Upgrades".
+local OPEN_ECHO_WINDOW = 0.5
+local openedAt = -math.huge
 local function open()
+	openedAt = os.clock()
 	sg.Enabled = true
+	pcall(closeOtherMenus) -- a faulty neighbour must never leave the page half-open
+	layoutLegend()
 	placeTopLeft()
 	placeBack()
 	liftCounter()
